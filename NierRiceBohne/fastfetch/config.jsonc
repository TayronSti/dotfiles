{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
	"source": "~/.config/fastfetch/nier.txt",
        "height": 15,
        "width": 30,
        "padding": {
            "top": 5,
            "left": 3
        },
	"color": {
	    "1": "38;2;117;108;99"
	},
	"printRemaining": false
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌───────────────────────SYSTEM───────────────────────┐"
        },
        {
            "type": "host",
            "key": "󰌢  PC",
            "keyColor": "\u001b[38;2;117;108;99m"
        },
        {
            "type": "cpu",
            "key": "│ ├󰻠 ",
            "keyColor": "\u001b[38;2;117;108;99m" 
        },
        {
            "type": "gpu",
            "key": "│ ├󰍹 ",
            "keyColor": "\u001b[38;2;117;108;99m"
	},
        {
            "type": "memory",
            "key": "│ ├󰑭 ",
            "keyColor": "\u001b[38;2;117;108;99m"
	},
        {
            "type": "disk",
            "key": "└ └󰋊 ",
            "keyColor": "\u001b[38;2;117;108;99m"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌──────────────────────SOFTWARE──────────────────────┐"
        },
        {
            "type": "os",
            "key": "  OS",
            "keyColor": "\u001b[38;2;117;108;99m"
        },
        {
            "type": "kernel",
            "key": "│ ├󰌽 ",
            "keyColor": "\u001b[38;2;117;108;99m"
        },
        {
            "type": "bios",
            "key": "│ ├󰖡 ",
            "keyColor": "\u001b[38;2;117;108;99m"
        },
        {
            "type": "packages",
            "key": "│ ├󰏗 ",
            "keyColor": "\u001b[38;2;117;108;99m"
        },
        {
            "type": "shell",
            "key": "│ ├󰞷 ",
            "keyColor": "\u001b[38;2;117;108;99m"
        },
        {
            "type": "de",
            "key": "󰧨  DE",
            "keyColor": "\u001b[38;2;117;108;99m"
        },
        {
            "type": "lm",
            "key": "│ ├󰍁 ",
            "keyColor": "\u001b[38;2;117;108;99m"
        },
        {
            "type": "wm",
            "key": "│ ├󱂬 ",
            "keyColor": "\u001b[38;2;117;108;99m"
        },
        {
            "type": "wmtheme",
            "key": "│ ├󰉦 ",
            "keyColor": "\u001b[38;2;117;108;99m"
        },
        {
            "type": "terminal",
            "key": "└ └󰆍 ",
            "keyColor": "\u001b[38;2;117;108;99m"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌─────────────────────────STATUS──────────────────────────┐"
        },
        {
            "type": "command",
            "key": "  ›  OS Age  ",
            "keyColor": "\u001b[38;2;117;108;99m",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "  ›  Uptime  ",
            "keyColor": "\u001b[38;2;117;108;99m"
        },
        {
            "type": "datetime",
            "key": "  ›  DateTime  ",
            "keyColor": "\u001b[38;2;117;108;99m"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└─────────────────────────────────────────────────────────┘"
        }
    ]
}
