{

  // General Settings

  // Position
  "layer": "top",
  "margin-top": 8,
  "margin-bottom": -4,

  "height": 16,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 0,

  // Load Modules
  "include": ["~/.config/waybar/modules.jsonc"],

  // Modules Left
  "modules-left": [
	  "wlr/taskbar",
	  "hyprland/window"	
  ],

  // Modules Center
  "modules-center": [
	  "hyprland/workspaces"
  ],

  // Modules Right
  "modules-right": [
	  "pulseaudio",
	  "group/hardware",
	  "network",
	  "custom/exit",
	  "clock"
  ]

}
